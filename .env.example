# URL pública del sitio (sitemap, canonical, User-Agent de Nominatim)
NEXT_PUBLIC_SITE_URL=https://gasolinaneta.es

# Caché de precios en Supabase (opcional en local: sin estas variables se usa .cache/fuel-snapshot.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Motor de rutas OSRM para distancias reales por carretera. Por defecto, el servidor público de demostración
# (vale para empezar; para producción, instancia propia: ver README). Sin respuesta, se usan distancias estimadas.
OSRM_URL=https://router.project-osrm.org

# Protege /api/cron/refresh. Vercel lo envía automáticamente al ejecutar el cron.
CRON_SECRET=

# Google AdSense: ca-pub-XXXXXXXXXXXXXXXX. Sin esto no se pinta ningún anuncio.
NEXT_PUBLIC_ADSENSE_CLIENT=
# IDs de bloque de anuncio creados en AdSense (opcionales; sin ellos, los huecos no se muestran)
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# true cuando hayas activado el mensaje de consentimiento de Google (Privacidad y mensajes → Normativas europeas).
# Entonces el CMP certificado de Google sustituye al banner propio para los anuncios.
NEXT_PUBLIC_USE_GOOGLE_CMP=false

# Analítica (elige una). Plausible no usa cookies; Google Analytics se carga solo con consentimiento.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
